# Local Kiosk Agent HTTP port
KIOSK_AGENT_PORT=3001

# GateStation identity (theo Ubiquitous Language trong báo cáo M1)
DEFAULT_FACTORY_ID=Binh Duong
DEFAULT_GATE_ID=GATE_BD_IN_01
DEFAULT_DIRECTION=IN

# Central Backend API URL (Nhóm 2 - Backend Core)
BACKEND_URL=http://localhost:3000
BACKEND_CHECKIN_PATH=/api/attendance/check-in
BACKEND_SYNC_PATH=/api/attendance/sync
BACKEND_HEALTH_PATH=/health
BACKEND_TIMEOUT_MS=1500

# Turnstile Controller API URL (Mock Server có sẵn tại port 4000)
TURNSTILE_URL=http://localhost:4000/api/turnstile/unlock

# Local SQLite database file (Store-and-Forward)
SQLITE_DB_PATH=./kiosk.db

# SyncAgent background interval (ms)
SYNC_INTERVAL_MS=5000

# Optional Edge HMAC-SHA256 verification for Offline mode
# Nếu để trống, Kiosk Agent vẫn kiểm tra định dạng payload & chống trùng nonce cục bộ khi mất mạng,
# còn xác thực chữ ký chính thức thực hiện tại Backend (hoặc khi đồng bộ).
EDGE_HMAC_SECRET=
QR_TTL_MS=30000
QR_CLOCK_SKEW_MS=5000
